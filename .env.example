# Application
NODE_ENV=development
API_PORT=3000
FRONTEND_URL=http://localhost:4200

# PostgreSQL
DATABASE_URL=postgresql://securecode:securecode_dev_password@localhost:5432/securecode?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# Token encryption
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_encryption_key

# GitHub App
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

# GitLab OAuth
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:3000/api/integrations/gitlab/callback
GITLAB_WEBHOOK_SECRET=

# Scanner
SCANNER_WORKSPACE_ROOT=./storage/workspaces
SCANNER_MAX_REPOSITORY_SIZE_MB=500
SCANNER_MAX_FILE_SIZE_MB=10
SCANNER_TIMEOUT_SECONDS=900
SCANNER_MAX_CONCURRENT_JOBS=2
