{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@securecode-platform/database": ["./packages/database/src/index.ts"],
      "@securecode-platform/queue-contracts": [
        "./packages/queue-contracts/src/index.ts"
      ],
      "@securecode-platform/scanner-core": [
        "./packages/scanner-core/src/index.ts"
      ],
      "@securecode-platform/scanner-rules": [
        "./packages/scanner-rules/src/index.ts"
      ],
      "@securecode-platform/shared-types": [
        "./packages/shared-types/src/index.ts"
      ],
      "@securecode-platform/shared-utils": [
        "./packages/shared-utils/src/index.ts"
      ],
      "@securecode-platform/configuration": [
        "./packages/configuration/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
